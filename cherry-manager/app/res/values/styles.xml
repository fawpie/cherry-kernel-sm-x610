<resources>
    <style name="CherryTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#FFF7F8</item>
        <item name="android:colorAccent">#993956</item>
        <item name="android:statusBarColor">#FFF7F8</item>
        <item name="android:navigationBarColor">#FFF7F8</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="CherryDarkTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#1D161A</item>
        <item name="android:colorAccent">#FFA9C3</item>
        <item name="android:statusBarColor">#1D161A</item>
        <item name="android:navigationBarColor">#1D161A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
