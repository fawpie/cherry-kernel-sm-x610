+++ b/kernel/fawpie_manager.c
@@ -0,0 +1,49 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/errno.h>
+#include <linux/init.h>
+#include <linux/kconfig.h>
+#include <linux/kobject.h>
+#include <linux/sysfs.h>
+
+static ssize_t abi_version_show(struct kobject *kobj,
+				struct kobj_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "1\n");
+}
+
+static ssize_t variant_show(struct kobject *kobj,
+			    struct kobj_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%s\n",
+			  IS_ENABLED(CONFIG_KSU) ? "ksun" : "standart");
+}
+
+static struct kobj_attribute abi_version_attribute = __ATTR_RO(abi_version);
+static struct kobj_attribute variant_attribute = __ATTR_RO(variant);
+
+static struct attribute *fawpie_manager_attrs[] = {
+	&abi_version_attribute.attr,
+	&variant_attribute.attr,
+	NULL,
+};
+
+static const struct attribute_group fawpie_manager_group = {
+	.attrs = fawpie_manager_attrs,
+};
+
+static int __init fawpie_manager_init(void)
+{
+	struct kobject *kobj;
+	int ret;
+
+	kobj = kobject_create_and_add("fawpie_manager", kernel_kobj);
+	if (!kobj)
+		return -ENOMEM;
+
+	ret = sysfs_create_group(kobj, &fawpie_manager_group);
+	if (ret)
+		kobject_put(kobj);
+
+	return ret;
+}
+late_initcall(fawpie_manager_init);
