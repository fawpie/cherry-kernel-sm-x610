@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/cred.h>
+#include <linux/delay.h>
+#include <linux/err.h>
+#include <linux/init.h>
+#include <linux/kthread.h>
+#include <linux/sched/signal.h>
+#include <linux/seq_file.h>
+#include <linux/string.h>
+#include <linux/timekeeping.h>
+#include <linux/uidgid.h>
+#include <linux/fawpie_ksu_boot_diag.h>
+
+#define FAWPIE_SHELL_UID 2000
+#define FAWPIE_DIAG_POLL_MS 200
+#define FAWPIE_DIAG_CHECKPOINT_MS 1800
+
+struct fawpie_diag_event {
+	const char *step;
+	u64 elapsed_ms;
+};
+
+static struct fawpie_diag_event events[32];
+static unsigned int event_count;
+
+extern int kernelsu_init(void);
+
+static void fawpie_ksu_diag_record(const char *step)
+{
+	unsigned int index = READ_ONCE(event_count);
+
+	pr_notice("fawpie-ksu-boot: %s\n", step);
+	if (index < ARRAY_SIZE(events)) {
+		events[index].step = step;
+		events[index].elapsed_ms = ktime_to_ms(ktime_get_boottime());
+		smp_store_release(&event_count, index + 1);
+	}
+}
+
+void fawpie_ksu_diag_step(const char *step)
+{
+	fawpie_ksu_diag_record(step);
+	/* Let the already-running host capture this marker before the next call. */
+	msleep(FAWPIE_DIAG_CHECKPOINT_MS);
+}
+
+void fawpie_ksu_diag_show(struct seq_file *m)
+{
+	unsigned int end = smp_load_acquire(&event_count);
+	unsigned int index;
+
+	for (index = 0; index < end; index++)
+		seq_printf(m, "fawpie-ksu-boot %llu %s\n",
+			   events[index].elapsed_ms, events[index].step);
+}
+
+static bool fawpie_ksu_diag_requested(void)
+{
+	struct task_struct *task, *parent;
+	char comm[TASK_COMM_LEN], parent_comm[TASK_COMM_LEN];
+	bool requested = false;
+
+	rcu_read_lock();
+	for_each_process(task) {
+		if (!uid_eq(task_euid(task), KUIDT_INIT(FAWPIE_SHELL_UID)))
+			continue;
+
+		get_task_comm(comm, task);
+		if (strcmp(comm, "fawpie-ksu-go"))
+			continue;
+
+		parent = rcu_dereference(task->real_parent);
+		if (parent) {
+			get_task_comm(parent_comm, parent);
+			if (!strcmp(parent_comm, "adbd")) {
+				requested = true;
+				break;
+			}
+		}
+	}
+	rcu_read_unlock();
+	return requested;
+}
+
+static int fawpie_ksu_diag_thread(void *unused)
+{
+	while (!fawpie_ksu_diag_requested())
+		msleep(FAWPIE_DIAG_POLL_MS);
+
+	fawpie_ksu_diag_step("authorized-usb-shell-ready");
+	if (kernelsu_init())
+		fawpie_ksu_diag_record("ksu-init-returned-error");
+	else
+		fawpie_ksu_diag_record("ksu-init-complete");
+	return 0;
+}
+
+int __init fawpie_ksu_diag_arm(void)
+{
+	struct task_struct *thread;
+
+	fawpie_ksu_diag_record("waiting-for-authorized-adb");
+	thread = kthread_run(fawpie_ksu_diag_thread, NULL, "fawpie_ksu_diag");
+	if (IS_ERR(thread)) {
+		fawpie_ksu_diag_record("could-not-arm-ksu-thread");
+		return PTR_ERR(thread);
+	}
+	return 0;
+}
