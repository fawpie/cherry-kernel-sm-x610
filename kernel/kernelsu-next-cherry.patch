diff --git a/kernel/hook/arm64/syscall_hook.c b/kernel/hook/arm64/syscall_hook.c
index 7bd6df06..a83abcc9 100644
--- a/kernel/hook/arm64/syscall_hook.c
+++ b/kernel/hook/arm64/syscall_hook.c
@@ -4,6 +4,7 @@
 
 #include <linux/kallsyms.h>
 #include <linux/mutex.h>
+#include <linux/cherry_ksu.h>
 #include <asm/cacheflush.h>
 #include "infra/symbol_resolver.h"
 #include "../patch_memory.h"
@@ -17,6 +18,53 @@ int ksu_dispatcher_nr = -1;
 // context, written with WRITE_ONCE from init/exit context.
 static ksu_syscall_hook_fn syscall_hooks[__NR_syscalls];
 
+#ifdef CONFIG_CHERRY_KSU_STATIC_HOOKS
+/*
+ * The native arm64 dispatch calls this after seccomp and Samsung DEFEX.
+ * Init's two temporary bootstrap callbacks retain the original syscall
+ * pointers. The kernel's read-only syscall table is never modified here.
+ */
+static syscall_fn_t init_read_hook;
+static syscall_fn_t init_fstat_hook;
+
+bool cherry_ksu_dispatch(const struct pt_regs *regs, unsigned int nr, long *result)
+{
+    syscall_fn_t init_hook = NULL;
+    ksu_syscall_hook_fn hook;
+
+    if (unlikely(is_global_init(current))) {
+        if (nr == __NR_read)
+            init_hook = smp_load_acquire(&init_read_hook);
+        else if (nr == __NR_fstat)
+            init_hook = smp_load_acquire(&init_fstat_hook);
+
+        if (init_hook) {
+            *result = init_hook(regs);
+            return true;
+        }
+    }
+
+    if (!test_thread_flag(TIF_SYSCALL_TRACEPOINT) || nr >= __NR_syscalls)
+        return false;
+
+    hook = READ_ONCE(syscall_hooks[nr]);
+    if (!hook)
+        return false;
+
+    *result = hook(nr, regs);
+    return true;
+}
+
+static syscall_fn_t *cherry_init_hook_slot(int nr)
+{
+    if (nr == __NR_read)
+        return &init_read_hook;
+    if (nr == __NR_fstat)
+        return &init_fstat_hook;
+    return NULL;
+}
+#endif
+
 // Track all hooked syscall entries for restoration.
 // Protected by hooked_entries_lock.
 struct syscall_hook_entry {
@@ -51,6 +99,15 @@ static int patch_syscall_table(int nr, syscall_fn_t fn)
 // save original to *old, and record for restoration at module exit.
 void ksu_syscall_table_hook(int nr, syscall_fn_t fn, syscall_fn_t *old)
 {
+#ifdef CONFIG_CHERRY_KSU_STATIC_HOOKS
+    syscall_fn_t *slot = cherry_init_hook_slot(nr);
+
+    if (WARN_ON_ONCE(!slot || !old || !fn))
+        return;
+    *old = sys_call_table[nr];
+    smp_store_release(slot, fn);
+    return;
+#endif
     if (ksu_syscall_table == NULL)
         return;
     if (nr < 0 || nr >= __NR_syscalls) {
@@ -93,6 +150,13 @@ void ksu_syscall_table_hook(int nr, syscall_fn_t fn, syscall_fn_t *old)
 // Restore syscall_table[nr] to its original value and remove from tracking list.
 void ksu_syscall_table_unhook(int nr)
 {
+#ifdef CONFIG_CHERRY_KSU_STATIC_HOOKS
+    syscall_fn_t *slot = cherry_init_hook_slot(nr);
+
+    if (slot)
+        smp_store_release(slot, NULL);
+    return;
+#endif
     int i;
 
     if (ksu_syscall_table == NULL)
@@ -202,6 +266,11 @@ bool ksu_has_syscall_hook(int nr)
 
 void __init ksu_syscall_hook_init(void)
 {
+#ifdef CONFIG_CHERRY_KSU_STATIC_HOOKS
+    ksu_syscall_table = (syscall_fn_t *)sys_call_table;
+    pr_info("Cherry Kernel: native KernelSU syscall dispatch ready\n");
+    return;
+#endif
     int ni_slot;
 
     memset(syscall_hooks, 0, sizeof(syscall_hooks));
